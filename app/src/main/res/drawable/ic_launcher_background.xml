<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer. A very slightly tinted wash (#FFFFFF → #F2F2F2) rather than a
  flat white: launchers that draw a drop shadow or a light-grey icon backdrop would otherwise make
  the icon look like a hole in the screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFF2F2F2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
