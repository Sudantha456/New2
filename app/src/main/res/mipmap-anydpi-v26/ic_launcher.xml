<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. `minSdk` is 26, so the `-anydpi-v26` qualifier is the *only* launcher
  icon the app ships: no legacy PNG densities, no mipmap-hdpi/xhdpi/xxhdpi directories, and the
  launcher composes the two layers itself (with the user's chosen mask shape).

  `monochrome` is the Android 13+ themed-icon layer: when the user enables themed icons, the
  launcher tints that silhouette with the wallpaper palette instead of drawing our red plate.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
